@model List<TimeCapsuleItem>
@{
    ViewData["Title"] = "GLOW Capsule — Hộp thời gian";
}

<div class="glow-hero-banner" style="background: linear-gradient(135deg, #FAF5FF 0%, #E9D5FF 50%, #FBCFE8 100%);">
    <div class="glow-hero-content">
        <div class="glow-hero-badge">⏳ GLOW Capsule — Time Capsule</div>
        <h1>Hộp thư gửi bản thân trong tương lai 💌</h1>
        <p>Khóa lại những ước mơ, cảm xúc và hình ảnh hiện tại. Chiếc hộp chỉ được mở ra sau mốc thời gian bạn đã chọn!</p>
    </div>
    <button class="btn-glow btn-lavender" onclick="document.getElementById('create-capsule-modal').style.display = 'block';">+ Khóa một hộp thời gian mới</button>
</div>

<!-- Modal Tạo Time Capsule -->
<div id="create-capsule-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 999; backdrop-filter: blur(4px);">
    <div style="background: white; max-width: 550px; margin: 2rem auto; padding: 2rem; border-radius: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="font-size: 1.3rem; font-weight: 800;">Niêm phong Hộp Thời Gian ⏳</h2>
            <button onclick="document.getElementById('create-capsule-modal').style.display = 'none';" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">✕</button>
        </div>
        <form asp-action="CreateCapsule" method="post">
            <div class="form-group">
                <label class="form-label">Tên hộp thời gian:</label>
                <input type="text" name="title" class="form-control" placeholder="VD: Thư gửi tôi của 1 năm sau..." required />
            </div>
            <div class="form-group">
                <label class="form-label">Thư gửi bản thân trong tương lai:</label>
                <textarea name="messageToFutureSelf" class="form-control" placeholder="Viết những lời dặn dò, tâm sự với bản thân sau này..." required style="min-height: 100px;"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Mục tiêu hiện tại bạn muốn hoàn thành:</label>
                <input type="text" name="currentGoals" class="form-control" placeholder="VD: Tốt nghiệp loại Giỏi, đạt IELTS 7.5..." />
            </div>
            <div class="form-group">
                <label class="form-label">Cảm xúc hiện tại của bạn:</label>
                <input type="text" name="currentFeelings" class="form-control" placeholder="Hào hứng, tràn đầy hoài bão..." />
            </div>
            <div class="form-group">
                <label class="form-label">Ngày mở khóa (Unlock Date):</label>
                <input type="date" name="unlockDate" class="form-control" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" required />
            </div>
            <div class="form-group">
                <label class="form-label">Link ảnh kỷ niệm niêm phong kèm theo:</label>
                <input type="text" name="photoUrl" class="form-control" placeholder="https://..." />
            </div>
            <button type="submit" class="btn-glow btn-lavender" style="width: 100%;">🔒 Niêm phong hộp thời gian</button>
        </form>
    </div>
</div>

<div class="bento-grid">
    @foreach (var c in Model)
    {
        bool isReady = DateTime.Now >= c.UnlockDate || c.IsOpened;
        <div class="bento-card col-span-6" style="background: #FFFFFF; border: 2px solid @(isReady ? "#10B981" : "#E9D5FF");">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span class="glow-tag @(isReady ? "tag-mint" : "tag-lavender")">
                    @(isReady ? "🔓 Đã mở khóa" : "🔒 Đang niêm phong")
                </span>
                <span style="font-size: 0.8rem; color: var(--glow-text-muted);">
                    Ngày mở: <strong>@c.UnlockDate.ToString("dd/MM/yyyy")</strong>
                </span>
            </div>

            <h3 style="font-size: 1.25rem; font-weight: 800; color: #1E293B; margin-bottom: 0.5rem;">@c.Title</h3>
            
            @if (isReady)
            {
                <div style="background: #F0FDF4; padding: 1.25rem; border-radius: 16px; margin: 1rem 0;">
                    <p style="font-size: 0.95rem; color: #064E3B; line-height: 1.6; white-space: pre-line; margin-bottom: 0.75rem;">
                        💌 @c.MessageToFutureSelf
                    </p>
                    <div style="font-size: 0.85rem; color: #047857;">
                        🎯 <strong>Mục tiêu lúc đó:</strong> @c.CurrentGoals
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(c.PhotoUrl))
                {
                    <div style="height: 180px; border-radius: 12px; overflow: hidden; margin-top: 0.5rem;">
                        <img src="@c.PhotoUrl" alt="@c.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                }
            }
            else
            {
                <div style="background: #FAF5FF; padding: 2rem; border-radius: 16px; text-align: center; margin: 1rem 0;">
                    <div style="font-size: 3rem; margin-bottom: 0.5rem;">🔒 ✨</div>
                    <p style="font-weight: 700; color: #581C87;">Hộp thời gian đang được khóa bảo mật</p>
                    <p style="font-size: 0.85rem; color: var(--glow-text-muted); margin-top: 0.25rem;">
                        Sẽ tự động mở vào ngày <strong>@c.UnlockDate.ToString("dd/MM/yyyy")</strong> (còn @((c.UnlockDate - DateTime.Now).Days) ngày nữa).
                    </p>
                    <form asp-action="OpenCapsule" method="post" style="margin-top: 1rem;">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn-glow btn-outline btn-sm">Mở sớm ngay bây giờ (Demo) 🗝️</button>
                    </form>
                </div>
            }
        </div>
    }
</div>
