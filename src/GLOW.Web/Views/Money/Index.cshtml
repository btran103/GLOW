@model List<ExpenseItem>
@{
    ViewData["Title"] = "Quản lý Chi tiêu";
    decimal totalExpense = ViewBag.TotalExpense != null ? (decimal)ViewBag.TotalExpense : 0;
    decimal totalIncome = ViewBag.TotalIncome != null ? (decimal)ViewBag.TotalIncome : 0;
    decimal balance = ViewBag.Balance != null ? (decimal)ViewBag.Balance : 0;
}

<div class="glow-hero-banner" style="background: linear-gradient(135deg, #FDF2F8 0%, #FBCFE8 100%);">
    <div class="glow-hero-content">
        <div class="glow-hero-badge">💰 GLOW Money</div>
        <h1>Quản lý tài chính cá nhân thông minh & An tâm 💳</h1>
        <p>Theo dõi thói quen chi tiêu, xây dựng kế hoạch tiết kiệm để thỏa sức trải nghiệm tuổi trẻ!</p>
    </div>
</div>

<div class="bento-grid">
    <!-- Stat Cards (3 Cards) -->
    <div class="bento-card col-span-4" style="background: #ECFDF5;">
        <div class="bento-header">
            <span class="bento-title"><div class="bento-icon icon-mint">📈</div> Tổng Thu Nhập</span>
        </div>
        <div class="glow-stat-value" style="color: #059669;">+@totalIncome.ToString("N0") đ</div>
    </div>
    
    <div class="bento-card col-span-4" style="background: #FFF1F2;">
        <div class="bento-header">
            <span class="bento-title"><div class="bento-icon icon-pink">📉</div> Tổng Chi Tiêu</span>
        </div>
        <div class="glow-stat-value" style="color: #E11D48;">-@totalExpense.ToString("N0") đ</div>
    </div>

    <div class="bento-card col-span-4" style="background: #F0F9FF;">
        <div class="bento-header">
            <span class="bento-title"><div class="bento-icon icon-sky">🏦</div> Số Dư Hiện Tại</span>
        </div>
        <div class="glow-stat-value" style="color: #0284C7;">@balance.ToString("N0") đ</div>
    </div>

    <!-- Chart Breakdown (6 cols) -->
    <div class="bento-card col-span-6">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-lavender">📊</div>
                <span>Phân bổ chi tiêu theo danh mục</span>
            </div>
        </div>
        <div style="height: 260px; position: relative;">
            <canvas id="expenseChart"></canvas>
        </div>
    </div>

    <!-- Quick Add Transaction Form (6 cols) -->
    <div class="bento-card col-span-6">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-yellow">➕</div>
                <span>Ghi nhận khoản thu / chi mới</span>
            </div>
        </div>
        <form asp-action="AddExpense" method="post">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                <div class="form-group">
                    <label class="form-label">Nội dung:</label>
                    <input type="text" name="title" class="form-control" placeholder="VD: Trà sữa matcha" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Số tiền (VNĐ):</label>
                    <input type="number" name="amount" class="form-control" placeholder="45000" required />
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                <div class="form-group">
                    <label class="form-label">Loại:</label>
                    <select name="type" class="form-control">
                        <option value="Chi tiêu">Chi tiêu 🔴</option>
                        <option value="Thu nhập">Thu nhập 🟢</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Danh mục:</label>
                    <select name="category" class="form-control">
                        <option value="Ăn uống">Ăn uống 🍜</option>
                        <option value="Học tập">Học tập 📚</option>
                        <option value="Đi lại">Đi lại 🚌</option>
                        <option value="Mua sắm">Mua sắm 👗</option>
                        <option value="Giải trí">Giải trí 🎬</option>
                        <option value="Sức khỏe">Sức khỏe ❤️</option>
                        <option value="Khác">Khác ✨</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Địa điểm:</label>
                <input type="text" name="locationName" class="form-control" placeholder="VD: The Coffee House" />
            </div>
            <button type="submit" class="btn-glow btn-mint" style="width: 100%;">Lưu giao dịch 💳</button>
        </form>
    </div>

    <!-- Expense History Table (12 cols) -->
    <div class="bento-card col-span-12">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-mint">📋</div>
                <span>Lịch sử giao dịch gần đây</span>
            </div>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--glow-border); color: var(--glow-text-muted);">
                        <th style="padding: 0.75rem;">Thời gian</th>
                        <th style="padding: 0.75rem;">Nội dung</th>
                        <th style="padding: 0.75rem;">Danh mục</th>
                        <th style="padding: 0.75rem;">Địa điểm</th>
                        <th style="padding: 0.75rem; text-align: right;">Số tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--glow-border);">
                            <td style="padding: 0.75rem; color: var(--glow-text-muted);">@e.Date.ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="padding: 0.75rem; font-weight: 700;">@e.Title</td>
                            <td style="padding: 0.75rem;"><span class="glow-tag tag-lavender">@e.Category</span></td>
                            <td style="padding: 0.75rem; color: var(--glow-text-muted);">@e.LocationName</td>
                            <td style="padding: 0.75rem; text-align: right; font-weight: 800; color: @(e.Type == "Thu nhập" ? "#059669" : "#E11D48");">
                                @(e.Type == "Thu nhập" ? "+" : "-")@e.Amount.ToString("N0") đ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const ctx = document.getElementById('expenseChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Ăn uống', 'Học tập', 'Đi lại', 'Mua sắm', 'Giải trí', 'Khác'],
                    datasets: [{
                        data: [55, 20, 10, 8, 5, 2],
                        backgroundColor: [
                            '#FBCFE8',
                            '#A7F3D0',
                            '#BAE6FD',
                            '#FDE68A',
                            '#E9D5FF',
                            '#CBD5E1'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });
        });
    </script>
}
