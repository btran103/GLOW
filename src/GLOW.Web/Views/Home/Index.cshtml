@model GLOW.Models.HomeDashboardViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Greeting Banner -->
<div class="glow-hero-banner">
    <div class="glow-hero-content">
        <div class="glow-hero-badge">✨ @DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</div>
        <h1>Chào @Model.Profile.Nickname! Hôm nay của bạn thế nào? 🌈</h1>
        <p>@Model.DailyAffirmation</p>
    </div>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a asp-controller="Diary" asp-action="Index" class="btn-glow btn-yellow">📖 Viết Nhật ký AI</a>
        <a asp-controller="AiChat" asp-action="Index" class="btn-glow btn-mint">🤖 Chat với AI</a>
    </div>
</div>

<!-- Bento Grid Dashboard -->
<div class="bento-grid">
    
    <!-- 1. Mood & Năng lượng (4 cols) -->
    <div class="bento-card col-span-4" style="background: linear-gradient(135deg, #FFFFFF 0%, #FAF5FF 100%);">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-lavender">😊</div>
                <span>Cảm xúc & Năng lượng</span>
            </div>
            <span class="glow-tag tag-lavender">Hôm nay</span>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-around; margin: 1rem 0;">
            <div style="text-align: center;">
                <div style="font-size: 3rem; line-height: 1;">@(Model.TodayMood?.MoodEmoji ?? "🥰")</div>
                <div style="font-weight: 700; margin-top: 0.4rem; color: #7E22CE;">@(Model.TodayMood?.MoodLabel ?? "Vui vẻ & Hứng khởi")</div>
            </div>
            <div style="text-align: center;">
                <div class="glow-stat-value" style="color: #F59E0B;">@(Model.TodayMood?.EnergyScore ?? 8)/10</div>
                <div class="glow-stat-label">⚡ Mức năng lượng</div>
            </div>
        </div>
        <p style="font-size: 0.875rem; color: var(--glow-text-muted); background: rgba(255,255,255,0.7); padding: 0.75rem; border-radius: 12px;">
            💭 <strong>Niềm vui:</strong> @(Model.TodayMood?.JoyTriggers ?? "Hoàn thành tốt các mục tiêu học tập!")
        </p>
        <div style="margin-top: auto; padding-top: 1rem;">
            <a asp-controller="Mood" asp-action="Index" class="btn-glow btn-outline btn-sm" style="width: 100%;">Cập nhật cảm xúc →</a>
        </div>
    </div>

    <!-- 2. Sức khỏe & Nước (4 cols) -->
    <div class="bento-card col-span-4" style="background: linear-gradient(135deg, #FFFFFF 0%, #F0F9FF 100%);">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-sky">💧</div>
                <span>Sức khỏe & Nước</span>
            </div>
            <span class="glow-tag tag-sky">@Model.TodayWaterMl / @Model.WaterGoalMl ml</span>
        </div>
        
        <!-- Water Progress Bar -->
        @{
            int waterPercent = Math.Min(100, (int)((double)Model.TodayWaterMl / Model.WaterGoalMl * 100));
        }
        <div style="background: #E0F2FE; border-radius: 9999px; height: 12px; overflow: hidden; margin: 0.75rem 0;">
            <div style="background: linear-gradient(90deg, #38BDF8, #0284C7); height: 100%; width: @waterPercent%; border-radius: 9999px; transition: width 0.5s;"></div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin: 0.5rem 0;">
            <div class="glow-stat-box" style="padding: 0.85rem;">
                <span class="glow-stat-value" style="font-size: 1.35rem;">@(Model.TodayHealth?.SleepHours ?? 7.8)h</span>
                <span class="glow-stat-label">😴 Giấc ngủ đêm</span>
            </div>
            <div class="glow-stat-box" style="padding: 0.85rem;">
                <span class="glow-stat-value" style="font-size: 1.35rem;">@(Model.TodayHealth?.StepsCount ?? 6800)</span>
                <span class="glow-stat-label">👟 Bước chân</span>
            </div>
        </div>

        <form asp-controller="Health" asp-action="AddWater" method="post" style="margin-top: auto; display: flex; gap: 0.5rem;">
            <input type="hidden" name="amountMl" value="250" />
            <button type="submit" class="btn-glow btn-mint btn-sm" style="flex: 1;">+ 250ml Nước 💧</button>
            <a asp-controller="Health" asp-action="Index" class="btn-glow btn-outline btn-sm">Chi tiết</a>
        </form>
    </div>

    <!-- 3. Học tập & Pomodoro (4 cols) -->
    <div class="bento-card col-span-4" style="background: linear-gradient(135deg, #FFFFFF 0%, #ECFDF5 100%);">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-mint">📚</div>
                <span>Học tập hôm nay</span>
            </div>
            <span class="glow-tag tag-mint">@Model.TodayStudyMinutes phút</span>
        </div>
        <div style="margin-bottom: 0.75rem;">
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--glow-text-muted); margin-bottom: 0.5rem;">Nhiệm vụ cần làm:</div>
            @if (Model.PendingStudyTasks.Any())
            {
                foreach (var t in Model.PendingStudyTasks)
                {
                    <div class="glow-list-item" style="padding: 0.5rem 0.75rem; font-size: 0.85rem;">
                        <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;">📖 @t.Title</span>
                        <span class="glow-tag tag-yellow">@t.EstimatedMinutes p</span>
                    </div>
                }
            }
            else
            {
                <p style="font-size: 0.85rem; color: var(--glow-text-muted);">Đã hoàn thành hết bài tập! Tuyệt vời 🌟</p>
            }
        </div>
        <div style="margin-top: auto;">
            <a asp-controller="Study" asp-action="Index" class="btn-glow btn-mint btn-sm" style="width: 100%;">Bắt đầu học Pomodoro ⏱️</a>
        </div>
    </div>

    <!-- 4. Nhật ký AI - Hôm nay của bạn (8 cols) -->
    <div class="bento-card col-span-8" style="background: linear-gradient(135deg, #FFFDF9 0%, #FEF3C7 100%);">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-yellow">📖</div>
                <span>GLOW Diary — Tổng kết ngày hôm nay</span>
            </div>
            <span class="glow-tag tag-yellow">AI Reflection ✨</span>
        </div>
        @if (Model.TodayDiary != null)
        {
            <h3 style="font-size: 1.15rem; font-weight: 800; color: #92400E; margin-bottom: 0.5rem;">@Model.TodayDiary.Title</h3>
            <p style="font-size: 0.95rem; color: #451A03; margin-bottom: 1rem; line-height: 1.6;">@Model.TodayDiary.Summary</p>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div style="background: rgba(255,255,255,0.8); padding: 0.85rem; border-radius: 12px;">
                    <div style="font-weight: 700; color: #065F46; font-size: 0.85rem; margin-bottom: 0.25rem;">✨ Điều tốt hôm nay:</div>
                    <div style="font-size: 0.825rem; white-space: pre-line; color: #1F2937;">@Model.TodayDiary.GoodThings</div>
                </div>
                <div style="background: rgba(255,255,255,0.8); padding: 0.85rem; border-radius: 12px;">
                    <div style="font-weight: 700; color: #9A3412; font-size: 0.85rem; margin-bottom: 0.25rem;">🌅 Gợi ý ngày mai:</div>
                    <div style="font-size: 0.825rem; white-space: pre-line; color: #1F2937;">@Model.TodayDiary.TomorrowSuggestions</div>
                </div>
            </div>
        }
        else
        {
            <p style="color: var(--glow-text-muted); margin-bottom: 1.5rem;">Chưa tạo nhật ký tổng kết cho hôm nay. AI đã sẵn sàng kết nối toàn bộ hoạt động của bạn!</p>
            <form asp-controller="Diary" asp-action="GenerateAiDiary" method="post">
                <input type="hidden" name="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn-glow btn-yellow">🤖 Tạo Nhật ký AI ngay bây giờ</button>
            </form>
        }
        <div style="margin-top: auto; display: flex; justify-content: flex-end;">
            <a asp-controller="Diary" asp-action="Index" class="btn-glow btn-outline btn-sm">Xem tất cả nhật ký →</a>
        </div>
    </div>

    <!-- 5. Chi tiêu & Tài chính (4 cols) -->
    <div class="bento-card col-span-4" style="background: linear-gradient(135deg, #FFFFFF 0%, #FDF2F8 100%);">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-pink">💰</div>
                <span>Chi tiêu hôm nay</span>
            </div>
            <span class="glow-tag tag-pink">@Model.TodaySpent.ToString("N0") đ</span>
        </div>
        <div class="glow-stat-box" style="margin-bottom: 0.75rem; background: rgba(255,255,255,0.8);">
            <span class="glow-stat-value" style="color: #BE185D;">@Model.TodaySpent.ToString("N0") VNĐ</span>
            <span class="glow-stat-label">Tổng chi trong ngày</span>
        </div>
        <p style="font-size: 0.85rem; color: var(--glow-text-muted); margin-bottom: 1rem;">
            💡 <em>AI nhận xét: Chi tiêu chủ yếu cho bữa ăn dinh dưỡng và nạp năng lượng học tập.</em>
        </p>
        <div style="margin-top: auto;">
            <a asp-controller="Money" asp-action="Index" class="btn-glow btn-pink btn-sm" style="width: 100%;">Quản lý ví & Ghi chép thu chi →</a>
        </div>
    </div>

    <!-- 6. Kỷ niệm & Ảnh chụp (6 cols) -->
    <div class="bento-card col-span-6">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-mint">📸</div>
                <span>Khoảnh khắc & Kỷ niệm</span>
            </div>
            <a asp-controller="Moments" asp-action="Index" class="btn-glow btn-outline btn-sm">+ Thêm ảnh</a>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem;">
            @foreach (var m in Model.RecentMoments.Take(3))
            {
                <div style="border-radius: 16px; overflow: hidden; position: relative; height: 120px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                    <img src="@m.ImageUrl" alt="@m.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                    <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(0,0,0,0.7)); color: white; padding: 0.3rem 0.5rem; font-size: 0.75rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                        @m.Title
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- 7. Gợi ý ngày mai & Outfit (6 cols) -->
    <div class="bento-card col-span-6" style="background: linear-gradient(135deg, #FFFFFF 0%, #F7FEE7 100%);">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-lime">👗</div>
                <span>Gợi ý ngày mai</span>
            </div>
            <span class="glow-tag" style="background: #ECFCCB; color: #4D7C0F;">May mắn 🍀</span>
        </div>
        <div style="font-size: 0.9rem; line-height: 1.6; color: #1F2937;">
            <p>🎨 <strong>Màu sắc outfit gợi ý:</strong> @(Model.TomorrowPlan?.OutfitLuckyColor ?? "Mint Green & Cream White")</p>
            <p>👗 <strong>Trang phục:</strong> @(Model.TomorrowPlan?.SuggestedOutfit ?? "Áo thun năng động + Quần suông pastel")</p>
            <p>📚 <strong>Ưu tiên:</strong> @(Model.TomorrowPlan?.PriorityStudy ?? "Ôn tập bài học & đọc sách phát triển bản thân")</p>
        </div>
        <div style="margin-top: auto; padding-top: 0.75rem;">
            <a asp-controller="Tomorrow" asp-action="Index" class="btn-glow btn-outline btn-sm" style="width: 100%;">Xem kế hoạch chi tiết ngày mai →</a>
        </div>
    </div>

</div>
