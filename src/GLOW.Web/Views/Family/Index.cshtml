@model List<FamilyStory>
@{
    ViewData["Title"] = "Góc Tâm sự Gia đình";
}

<div class="glow-hero-banner" style="background: linear-gradient(135deg, #FFF1F2 0%, #FDF2F8 50%, #FDE68A 100%);">
    <div class="glow-hero-content">
        <div class="glow-hero-badge">👨‍👩‍👧 GLOW Family — Góc Riêng Tư</div>
        <h1>Nơi gửi gắm những yêu thương chưa từng ngỏ lời 🏡</h1>
        <p>Khu vực hoàn toàn riêng tư để bạn viết chuyện gia đình, lưu giữ kỷ niệm và giãi bày những tâm sự từ đáy lòng.</p>
    </div>
    <button class="btn-glow btn-pink" onclick="document.getElementById('add-story-modal').style.display = 'block';">+ Viết tâm sự gia đình</button>
</div>

<!-- Modal Thêm Tâm Sự Gia Đình -->
<div id="add-story-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 999; backdrop-filter: blur(4px);">
    <div style="background: white; max-width: 550px; margin: 3rem auto; padding: 2rem; border-radius: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="font-size: 1.3rem; font-weight: 800;">Ghi lại khoảnh khắc gia đình ❤️</h2>
            <button onclick="document.getElementById('add-story-modal').style.display = 'none';" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">✕</button>
        </div>
        <form asp-action="AddStory" method="post">
            <div class="form-group">
                <label class="form-label">Tiêu đề mẩu chuyện:</label>
                <input type="text" name="title" class="form-control" placeholder="VD: Bữa cơm mẹ nấu ngày trở về" required />
            </div>
            <div class="form-group">
                <label class="form-label">Chuyện gia đình / Kỷ niệm:</label>
                <textarea name="content" class="form-control" placeholder="Kể lại mẩu chuyện ấm áp..." required></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Cảm xúc của bạn:</label>
                <input type="text" name="feelings" class="form-control" placeholder="Biết ơn, xúc động, ấm lòng..." />
            </div>
            <div class="form-group">
                <label class="form-label">Những điều muốn nói nhưng chưa nói:</label>
                <textarea name="unsaidWords" class="form-control" placeholder="Con yêu ba mẹ nhiều lắm..." style="min-height: 70px;"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Link ảnh kỷ niệm gia đình:</label>
                <input type="text" name="photoUrl" class="form-control" placeholder="https://..." />
            </div>
            <button type="submit" class="btn-glow btn-pink" style="width: 100%;">Lưu kỷ niệm gia đình 🌸</button>
        </form>
    </div>
</div>

<div class="bento-grid">
    @foreach (var s in Model)
    {
        <div class="bento-card col-span-6" style="background: #FFFFFF;">
            @if (!string.IsNullOrEmpty(s.PhotoUrl))
            {
                <div style="height: 200px; border-radius: 16px; overflow: hidden; margin-bottom: 1rem;">
                    <img src="@s.PhotoUrl" alt="@s.Title" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
            }
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                <span class="glow-tag tag-pink">❤️ Gia đình ấm áp</span>
                <span style="font-size: 0.8rem; color: var(--glow-text-muted);">@s.Date.ToString("dd/MM/yyyy")</span>
            </div>
            <h3 style="font-size: 1.2rem; font-weight: 800; color: #831843; margin-bottom: 0.5rem;">@s.Title</h3>
            <p style="font-size: 0.9rem; color: #334155; line-height: 1.6; margin-bottom: 0.75rem;">@s.Content</p>
            
            @if (!string.IsNullOrEmpty(s.UnsaidWords))
            {
                <div style="background: #FFF1F2; border-left: 3px solid #F43F5E; padding: 0.75rem; border-radius: 8px; font-size: 0.85rem; color: #881337; margin-bottom: 0.75rem;">
                    💌 <strong>Điều muốn nói:</strong> @s.UnsaidWords
                </div>
            }

            <div style="background: #F8FAFC; padding: 0.75rem; border-radius: 12px; font-size: 0.8rem; color: #065F46; margin-top: auto;">
                🤖 <strong>AI Lắng nghe:</strong> @s.AiReflection
            </div>
        </div>
    }
</div>
