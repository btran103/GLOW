@model List<MapMemory>
@{
    ViewData["Title"] = "Bản đồ Cuộc sống";
    var privacy = ViewBag.PrivacySettings as UserPrivacySetting ?? new UserPrivacySetting();
}

<div class="glow-hero-banner" style="background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%);">
    <div class="glow-hero-content">
        <div class="glow-hero-badge">📍 GLOW Map — Memory Map</div>
        <h1>Bản đồ hành trình & Dấu chân kỷ niệm 🗺️</h1>
        <p>Ghi lại những nơi bạn đã đi qua, thời gian lưu trú và những cảm xúc đẹp đẽ tại từng tọa độ!</p>
    </div>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <form asp-action="ToggleTracking" method="post" style="margin: 0;">
            <button type="submit" class="btn-glow @(privacy.LocationEnabled ? "btn-mint" : "btn-outline")">
                @(privacy.LocationEnabled ? "🔒 Định vị: Đang BẬT" : "⏸ Định vị: Đang TẮT")
            </button>
        </form>
        <button class="btn-glow btn-yellow" onclick="document.getElementById('add-place-modal').style.display = 'block';">+ Check-in điểm mới</button>
    </div>
</div>

<!-- Modal Check-in Địa Điểm Mới -->
<div id="add-place-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 999; backdrop-filter: blur(4px);">
    <div style="background: white; max-width: 500px; margin: 3rem auto; padding: 2rem; border-radius: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2 style="font-size: 1.3rem; font-weight: 800;">Check-in Địa điểm mới 📍</h2>
            <button onclick="document.getElementById('add-place-modal').style.display = 'none';" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">✕</button>
        </div>
        <form asp-action="AddPlace" method="post">
            <div class="form-group">
                <label class="form-label">Tên địa điểm:</label>
                <input type="text" name="placeName" class="form-control" placeholder="VD: The Coffee House Trần Cao Vân" required />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label class="form-label">Danh mục:</label>
                    <select name="category" class="form-control">
                        <option value="Cafe">Cafe & Trà sữa ☕</option>
                        <option value="Trường học">Trường học 🎓</option>
                        <option value="Công viên">Công viên & Dạo bộ 🌳</option>
                        <option value="Ăn uống">Quán ăn ngon 🍜</option>
                        <option value="Du lịch">Du lịch 🏖️</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Thời gian ở đó (phút):</label>
                    <input type="number" name="durationMinutes" class="form-control" value="120" />
                </div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label class="form-label">Vĩ độ (Lat):</label>
                    <input type="number" step="0.0001" name="latitude" id="input-lat" class="form-control" value="10.7769" />
                </div>
                <div class="form-group">
                    <label class="form-label">Kinh độ (Lng):</label>
                    <input type="number" step="0.0001" name="longitude" id="input-lng" class="form-control" value="106.7009" />
                </div>
            </div>

            <div style="margin-bottom: 1rem;">
                <button type="button" class="btn-glow btn-outline btn-sm" onclick="getCurrentLocation('input-lat', 'input-lng', 'geo-status')">📍 Lấy vị trí GPS hiện tại</button>
                <span id="geo-status" style="font-size: 0.8rem; color: var(--glow-text-muted); margin-left: 0.5rem;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Hoạt động tại đây:</label>
                <input type="text" name="activity" class="form-control" placeholder="Học bài, làm việc, tâm sự cùng bạn..." />
            </div>
            <div class="form-group">
                <label class="form-label">Cảm xúc:</label>
                <input type="text" name="feeling" class="form-control" placeholder="Tập trung và thoải mái" />
            </div>
            <button type="submit" class="btn-glow btn-mint" style="width: 100%;">Lưu điểm đến 🗺️</button>
        </form>
    </div>
</div>

<div class="bento-grid">
    <!-- Map Canvas (8 cols) -->
    <div class="bento-card col-span-8" style="padding: 0; overflow: hidden; min-height: 480px;">
        <div id="leaflet-map" style="width: 100%; height: 480px;"></div>
    </div>

    <!-- Places List (4 cols) -->
    <div class="bento-card col-span-4">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-sky">📌</div>
                <span>Điểm đến gần đây</span>
            </div>
            <span class="glow-tag tag-sky">@Model.Count địa điểm</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem; max-height: 400px; overflow-y: auto;">
            @foreach (var p in Model)
            {
                <div class="glow-list-item" style="flex-direction: column; align-items: flex-start; gap: 0.35rem;">
                    <div style="display: flex; justify-content: space-between; width: 100%;">
                        <span style="font-weight: 800; font-size: 0.95rem; color: #0369A1;">@p.PlaceName</span>
                        <span class="glow-tag tag-mint">@p.DurationMinutes phút</span>
                    </div>
                    <p style="font-size: 0.8rem; color: var(--glow-text-muted);">
                        🎯 <strong>Hoạt động:</strong> @p.Activity
                    </p>
                    <p style="font-size: 0.8rem; color: #065F46;">
                        😊 <strong>Cảm xúc:</strong> @p.Feeling
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize Leaflet Map centered around HCMC
            const map = L.map('leaflet-map').setView([10.7769, 106.7009], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Add markers for all memories
            const places = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new {
                name = p.PlaceName,
                lat = p.Latitude,
                lng = p.Longitude,
                act = p.Activity,
                feel = p.Feeling,
                dur = p.DurationMinutes
            })));

            places.forEach(p => {
                L.marker([p.lat, p.lng])
                    .addTo(map)
                    .bindPopup(`<strong>${p.name}</strong><br>⏱️ ${p.dur} phút<br>🎯 ${p.act}<br>😊 ${p.feel}`);
            });
        });
    </script>
}
