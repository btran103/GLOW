@model UserProfile
@{
    ViewData["Title"] = "Trang cá nhân & Quyền riêng tư";
    var privacy = ViewBag.Privacy as UserPrivacySetting ?? new UserPrivacySetting();
    var appUser = ViewBag.AppUser as ApplicationUser;
    var successMsg = TempData["SuccessMessage"] as string;
    var currentAvatar = appUser?.AvatarUrl ?? Model.AvatarUrl;
}

<div class="glow-hero-banner" style="background: linear-gradient(135deg, #ECFDF5 0%, #FAF5FF 50%, #FEF3C7 100%);">
    <div class="glow-hero-content">
        <div class="glow-hero-badge">👤 Hồ Sơ & Quyền Riêng Tư</div>
        <h1>Không gian cá nhân & Bảo mật dữ liệu 🔒</h1>
        <p>GLOW luôn tôn trọng quyền riêng tư của bạn. Mọi dữ liệu đều được bảo vệ và bạn có toàn quyền kiểm soát!</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(successMsg))
{
    <div style="max-width: 800px; margin: 1rem auto; background: #ECFDF5; border: 1px solid #A7F3D0; padding: 0.75rem 1.25rem; border-radius: 12px; color: #065F46; font-weight: 600; text-align: center;">✅ @successMsg</div>
}

<div class="bento-grid">
    <!-- Avatar & Account Info Card -->
    <div class="bento-card col-span-4" style="text-align: center;">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-pink">📸</div>
                <span>Ảnh đại diện</span>
            </div>
        </div>
        
        <!-- Avatar with upload overlay -->
        <div id="avatarContainer" style="position: relative; display: inline-block; margin: 1rem 0;">
            <img id="avatarPreview" src="@currentAvatar" alt="Avatar" 
                 style="width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 4px solid transparent; background-image: linear-gradient(white, white), linear-gradient(135deg, #10B981, #F59E0B, #EC4899, #8B5CF6); background-origin: border-box; background-clip: content-box, border-box; box-shadow: 0 8px 25px rgba(0,0,0,0.1);" />
            <label for="avatarInput" style="position: absolute; bottom: 5px; right: 5px; width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #10B981, #84CC16); color: white; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 18px; box-shadow: 0 4px 12px rgba(16,185,129,0.4); transition: transform 0.2s;" 
                   onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
                📷
            </label>
            <input type="file" id="avatarInput" accept=".jpg,.jpeg,.png,.gif,.webp" style="display: none;" />
        </div>

        <!-- Upload progress -->
        <div id="uploadProgress" style="display: none; margin: 0.5rem 0;">
            <div style="width: 80%; margin: 0 auto; background: #E2E8F0; border-radius: 10px; height: 6px; overflow: hidden;">
                <div id="progressBar" style="height: 100%; background: linear-gradient(90deg, #10B981, #84CC16); border-radius: 10px; width: 0%; transition: width 0.3s;"></div>
            </div>
            <p style="font-size: 0.75rem; color: #64748B; margin-top: 0.25rem;">Đang tải ảnh lên...</p>
        </div>

        <!-- Upload status message -->
        <div id="uploadMessage" style="display: none; margin: 0.5rem 0; padding: 0.5rem; border-radius: 8px; font-size: 0.8rem;"></div>

        <!-- Drag & Drop zone -->
        <div id="dropZone" style="margin: 0.75rem 0; padding: 1.25rem; border: 2px dashed #CBD5E1; border-radius: 16px; cursor: pointer; transition: all 0.3s; background: #F8FAFC;"
             onclick="document.getElementById('avatarInput').click()">
            <div style="font-size: 1.5rem;">🖼️</div>
            <p style="color: #64748B; font-size: 0.8rem; margin: 0.25rem 0 0;">Kéo thả ảnh vào đây hoặc bấm để chọn</p>
            <p style="color: #94A3B8; font-size: 0.7rem;">JPG, PNG, GIF, WEBP — Tối đa 5MB</p>
        </div>

        <!-- Account Info -->
        @if (appUser != null)
        {
            <div style="margin-top: 1rem; text-align: left; padding: 1rem; background: #F8FAFC; border-radius: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <span style="font-size: 0.8rem; color: #64748B;">📧 Email</span>
                    <span style="font-size: 0.85rem; font-weight: 600; color: #1E293B;">@appUser.Email</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <span style="font-size: 0.8rem; color: #64748B;">👤 Username</span>
                    <span style="font-size: 0.85rem; font-weight: 600; color: #1E293B;">@@@appUser.Username</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 0.8rem; color: #64748B;">✉️ Xác thực</span>
                    @if (appUser.IsEmailConfirmed)
                    {
                        <span style="font-size: 0.8rem; font-weight: 700; color: #059669; background: #ECFDF5; padding: 2px 10px; border-radius: 8px;">✅ Đã xác thực</span>
                    }
                    else
                    {
                        <span style="font-size: 0.8rem; font-weight: 700; color: #DC2626; background: #FEF2F2; padding: 2px 10px; border-radius: 8px;">❌ Chưa xác thực</span>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Profile Edit Card (8 cols) -->
    <div class="bento-card col-span-8">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-mint">✨</div>
                <span>Thông tin cá nhân</span>
            </div>
        </div>
        <form asp-action="UpdateProfile" method="post">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label class="form-label">Nickname / Tên gọi:</label>
                    <input type="text" name="nickname" class="form-control" value="@Model.Nickname" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Gu thời trang yêu thích:</label>
                    <input type="text" name="preferredStyle" class="form-control" value="@Model.PreferredStyle" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Tiểu sử (Bio):</label>
                <input type="text" name="bio" class="form-control" value="@Model.Bio" />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem;">
                <div class="form-group">
                    <label class="form-label">Mục tiêu nước (ml):</label>
                    <input type="number" name="dailyWaterGoalMl" class="form-control" value="@Model.DailyWaterGoalMl" />
                </div>
                <div class="form-group">
                    <label class="form-label">Mục tiêu học (phút):</label>
                    <input type="number" name="dailyStudyGoalMinutes" class="form-control" value="@Model.DailyStudyGoalMinutes" />
                </div>
                <div class="form-group">
                    <label class="form-label">Mục tiêu ngủ (h):</label>
                    <input type="number" name="dailySleepGoalHours" class="form-control" value="@Model.DailySleepGoalHours" />
                </div>
            </div>
            <button type="submit" class="btn-glow btn-mint" style="width: 100%;">Lưu thông tin cá nhân ✨</button>
        </form>
    </div>

    <!-- Privacy Settings Card (12 cols full width) -->
    <div class="bento-card col-span-12" style="background: #FFFFFF;">
        <div class="bento-header">
            <div class="bento-title">
                <div class="bento-icon icon-lavender">🛡️</div>
                <span>Cài đặt Quyền riêng tư & AI</span>
            </div>
            <span class="glow-tag tag-lavender">Bảo mật cao</span>
        </div>
        <form asp-action="UpdatePrivacy" method="post">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #F8FAFC; border-radius: 12px; cursor: pointer;">
                    <div>
                        <div style="font-weight: 700; color: #1E293B;">📍 Theo dõi vị trí (Opt-in)</div>
                        <div style="font-size: 0.8rem; color: var(--glow-text-muted);">Cho phép GLOW Map ghi lại địa điểm</div>
                    </div>
                    <input type="checkbox" name="locationEnabled" value="true" @(privacy.LocationEnabled ? "checked" : "") style="transform: scale(1.3); cursor: pointer;" />
                </label>

                <label style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #F8FAFC; border-radius: 12px; cursor: pointer;">
                    <div>
                        <div style="font-weight: 700; color: #1E293B;">🤖 AI phân tích dữ liệu</div>
                        <div style="font-size: 0.8rem; color: var(--glow-text-muted);">Sử dụng dữ liệu để sinh nhật ký AI</div>
                    </div>
                    <input type="checkbox" name="allowAiDataAnalysis" value="true" @(privacy.AllowAiDataAnalysis ? "checked" : "") style="transform: scale(1.3); cursor: pointer;" />
                </label>

                <label style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #F8FAFC; border-radius: 12px; cursor: pointer;">
                    <div>
                        <div style="font-weight: 700; color: #1E293B;">👨👩👧 Bảo vệ góc gia đình</div>
                        <div style="font-size: 0.8rem; color: var(--glow-text-muted);">Giữ tâm sự gia đình siêu bảo mật</div>
                    </div>
                    <input type="checkbox" name="familyStoriesPrivate" value="true" @(privacy.FamilyStoriesPrivate ? "checked" : "") style="transform: scale(1.3); cursor: pointer;" />
                </label>

                <label style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #F8FAFC; border-radius: 12px; cursor: pointer;">
                    <div>
                        <div style="font-weight: 700; color: #1E293B;">📸 Ảnh Camera cục bộ</div>
                        <div style="font-size: 0.8rem; color: var(--glow-text-muted);">Không tải ảnh lên máy chủ công cộng</div>
                    </div>
                    <input type="checkbox" name="cameraHistoryLocalOnly" value="true" @(privacy.CameraHistoryLocalOnly ? "checked" : "") style="transform: scale(1.3); cursor: pointer;" />
                </label>
            </div>

            <button type="submit" class="btn-glow btn-lavender" style="width: 100%;">Lưu cài đặt bảo mật 🔒</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function() {
    const avatarInput = document.getElementById('avatarInput');
    const avatarPreview = document.getElementById('avatarPreview');
    const dropZone = document.getElementById('dropZone');
    const uploadProgress = document.getElementById('uploadProgress');
    const progressBar = document.getElementById('progressBar');
    const uploadMessage = document.getElementById('uploadMessage');

    // File input change
    avatarInput.addEventListener('change', function() {
        if (this.files && this.files[0]) {
            handleFile(this.files[0]);
        }
    });

    // Drag & drop
    dropZone.addEventListener('dragover', function(e) {
        e.preventDefault();
        this.style.borderColor = '#10B981';
        this.style.background = '#ECFDF5';
    });
    dropZone.addEventListener('dragleave', function(e) {
        e.preventDefault();
        this.style.borderColor = '#CBD5E1';
        this.style.background = '#F8FAFC';
    });
    dropZone.addEventListener('drop', function(e) {
        e.preventDefault();
        this.style.borderColor = '#CBD5E1';
        this.style.background = '#F8FAFC';
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
            handleFile(e.dataTransfer.files[0]);
        }
    });

    function handleFile(file) {
        // Validate
        const allowed = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
        if (!allowed.includes(file.type)) {
            showMessage('Chỉ chấp nhận file ảnh: JPG, PNG, GIF, WEBP', false);
            return;
        }
        if (file.size > 5 * 1024 * 1024) {
            showMessage('Ảnh không được vượt quá 5MB', false);
            return;
        }

        // Preview
        const reader = new FileReader();
        reader.onload = function(e) {
            avatarPreview.src = e.target.result;
        };
        reader.readAsDataURL(file);

        // Upload
        uploadAvatar(file);
    }

    function uploadAvatar(file) {
        const formData = new FormData();
        formData.append('avatarFile', file);

        uploadProgress.style.display = 'block';
        uploadMessage.style.display = 'none';
        progressBar.style.width = '30%';

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
            || document.querySelector('form input[name="__RequestVerificationToken"]')?.value;

        fetch('/Auth/UploadAvatar', {
            method: 'POST',
            body: formData,
            headers: token ? { 'RequestVerificationToken': token } : {}
        })
        .then(response => {
            progressBar.style.width = '80%';
            return response.json();
        })
        .then(data => {
            progressBar.style.width = '100%';
            setTimeout(() => {
                uploadProgress.style.display = 'none';
                if (data.success) {
                    showMessage('Đã cập nhật ảnh đại diện thành công! ✨', true);
                    avatarPreview.src = data.avatarUrl;
                    // Update navbar avatar too
                    const navAvatar = document.querySelector('.glow-avatar-sm');
                    if (navAvatar) navAvatar.src = data.avatarUrl;
                } else {
                    showMessage(data.message || 'Có lỗi xảy ra', false);
                }
            }, 300);
        })
        .catch(err => {
            uploadProgress.style.display = 'none';
            showMessage('Lỗi kết nối. Vui lòng thử lại.', false);
        });
    }

    function showMessage(text, isSuccess) {
        uploadMessage.style.display = 'block';
        uploadMessage.textContent = text;
        uploadMessage.style.background = isSuccess ? '#ECFDF5' : '#FEF2F2';
        uploadMessage.style.color = isSuccess ? '#065F46' : '#991B1B';
        uploadMessage.style.border = isSuccess ? '1px solid #A7F3D0' : '1px solid #FECACA';
        setTimeout(() => { uploadMessage.style.display = 'none'; }, 4000);
    }
})();
</script>
}
