@model GLOW.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản GLOW";
    Layout = "_Layout";
}

<div style="max-width: 540px; margin: 2rem auto;">
    <div class="bento-card" style="background: #FFFFFF; padding: 2.5rem; border-radius: 28px; box-shadow: var(--glow-shadow-hover);">
        
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 2rem;">
            <div class="glow-logo-circle" style="width: 56px; height: 56px; font-size: 1.4rem; margin: 0 auto 0.75rem auto;">GL</div>
            <h1 style="font-size: 1.75rem; font-weight: 800; color: #1E293B;">Đăng ký tài khoản GLOW 🌈</h1>
            <p style="color: var(--glow-text-muted); font-size: 0.95rem; margin-top: 0.35rem;">Bắt đầu hành trình ghi lại cuộc sống & thấu hiểu chính mình!</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background: #FFF1F2; border-left: 4px solid #F43F5E; padding: 0.85rem 1rem; border-radius: 12px; margin-bottom: 1.5rem; font-size: 0.875rem; color: #9F1239;">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="FullName" class="form-label">Họ và tên của bạn:</label>
                <input asp-for="FullName" class="form-control" placeholder="VD: Bảo Trân" required />
                <span asp-validation-for="FullName" style="font-size: 0.8rem; color: #E11D48;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email thực tế (Nhận mã xác nhận 6 số):</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="VD: baotran@gmail.com" required />
                <span asp-validation-for="Email" style="font-size: 0.8rem; color: #E11D48;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Username" class="form-label">Tên đăng nhập:</label>
                <input asp-for="Username" class="form-control" placeholder="baotran_glow" required />
                <span asp-validation-for="Username" style="font-size: 0.8rem; color: #E11D48;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Mật khẩu (Yêu cầu ký tự đặc biệt):</label>
                <input asp-for="Password" id="password-input" type="password" class="form-control" placeholder="••••••••" required oninput="checkPasswordStrength()" />
                <span asp-validation-for="Password" style="font-size: 0.8rem; color: #E11D48;"></span>

                <!-- Password Requirements Checklist -->
                <div style="background: #F8FAFC; border: 1px solid var(--glow-border); border-radius: 14px; padding: 0.85rem 1rem; margin-top: 0.75rem; font-size: 0.825rem;">
                    <div style="font-weight: 700; color: #475569; margin-bottom: 0.4rem;">Tiêu chuẩn mật khẩu an toàn:</div>
                    <div id="req-len" style="color: #94A3B8; margin-bottom: 0.2rem;">⭕ Tối thiểu 8 ký tự</div>
                    <div id="req-upper" style="color: #94A3B8; margin-bottom: 0.2rem;">⭕ Ít nhất 1 chữ hoa (A-Z)</div>
                    <div id="req-lower" style="color: #94A3B8; margin-bottom: 0.2rem;">⭕ Ít nhất 1 chữ thường (a-z)</div>
                    <div id="req-num" style="color: #94A3B8; margin-bottom: 0.2rem;">⭕ Ít nhất 1 chữ số (0-9)</div>
                    <div id="req-special" style="color: #94A3B8; font-weight: 700;">⭕ BẮT BUỘC 1 KÝ TỰ ĐẶC BIỆT (!, @@, #, $, %, ^, &, *, ...)</div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Xác nhận lại mật khẩu:</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" style="font-size: 0.8rem; color: #E11D48;"></span>
            </div>

            <button type="submit" class="btn-glow btn-mint" style="width: 100%; padding: 0.85rem; font-size: 1.05rem; margin-top: 0.5rem;">
                🚀 Tạo tài khoản & Gửi mã xác nhận Email
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--glow-text-muted);">
            Đã có tài khoản? <a asp-action="Login" style="color: #059669; font-weight: 700; text-decoration: none;">Đăng nhập ngay →</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function checkPasswordStrength() {
            const pass = document.getElementById('password-input').value;

            updateItem('req-len', pass.length >= 8);
            updateItem('req-upper', /[A-Z]/.test(pass));
            updateItem('req-lower', /[a-z]/.test(pass));
            updateItem('req-num', /[0-9]/.test(pass));
            updateItem('req-special', /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?~`]/.test(pass));
        }

        function updateItem(elementId, isValid) {
            const el = document.getElementById(elementId);
            if (!el) return;
            if (isValid) {
                el.innerHTML = '✅ ' + el.innerText.substring(2);
                el.style.color = '#059669';
            } else {
                el.innerHTML = '⭕ ' + el.innerText.substring(2);
                el.style.color = '#94A3B8';
            }
        }
    </script>
}
